{
  "name": "kpi-platform-frontend",
  "version": "1.1.0",
  "description": "Enterprise manufacturing KPI dashboard frontend - Vue 3/Vuetify/AG Grid",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:sqlite": "playwright test --config=playwright.sqlite.config.ts",
    "test:e2e:sqlite:headed": "playwright test --config=playwright.sqlite.config.ts --headed",
    "test:e2e:sqlite:report": "playwright show-report playwright-report-sqlite"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@mdi/font": "^7.4.47",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "ag-grid-community": "^35.3.0",
    "ag-grid-vue3": "^35.3.0",
    "axios": "^1.6.5",
    "chart.js": "^4.4.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "marked": "^18.0.9",
    "mermaid": "^11.12.2",
    "papaparse": "^5.6.0",
    "pinia": "^4.0.2",
    "vue": "^3.5.0",
    "vue-chartjs": "^5.3.4",
    "vue-i18n": "^11.4.2",
    "vue-qrcode-reader": "^5.7.3",
    "vue-router": "^5.2.0",
    "vuedraggable": "^4.1.0",
    "vuetify": "^4.1.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/papaparse": "^5.5.2",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.0.0",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.11.0",
    "happy-dom": "^20.6.1",
    "jsonc-eslint-parser": "^3.1.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.3",
    "vite": "^7.3.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.5",
    "yaml-eslint-parser": "^2.0.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "esbuild": "0.28.1",
    "brace-expansion": "^5.0.9"
  }
}
