# Coverage configuration (Run 7 T0.2).
#
# This file exists because coverage.py only reads .coveragerc / setup.cfg /
# tox.ini / pyproject.toml from the CURRENT DIRECTORY — the former
# [coverage:run] sections in backend/tests/pytest.ini were never read
# (`coverage debug config` showed "config_files_read: -none-"), and CI's
# `--cov=.` measured the test suite itself, inflating the 75% gate.
#
# The measured pool below is the explicit package list the suite has always
# used locally (the honest metric: 81.07% as of 2026-06-12). Deliberately
# excluded, as before: tests/, alembic/, scripts/, db/migrations/ (seeders),
# and the top-level modules main.py / config.py / database.py / constants.py
# — adding those to the pool is a separate, conscious decision.
#
# `seed` (S1b) IS in the pool, and the exclusion note above is why it needs
# saying out loud: that note names "scripts/, db/migrations/ (seeders)" and
# predates backend/seed/ existing. Inheriting it here would have left a
# ~1,900-line PRODUCTION package — shipped, invoked on the VM, and the single
# writer of the demo dataset — contributing zero to the 75% gate, which is
# exactly the accident Run 7's H-3/H-5 honest-gate remediation was about.
# Measured before adding: `coverage run --source=seed -m pytest tests/test_seed/`
# gives 781 statements, 9 missed, 98.85%, so including it RAISES the total
# rather than eating headroom.

[run]
source =
    audit
    auth
    cache
    calculations
    crud
    db
    endpoints
    events
    exceptions
    middleware
    orm
    routes
    schemas
    seed
    services
    simulation_v2
    tasks
    utils
omit =
    */tests/*
    */__pycache__/*
    */migrations/*
    */conftest.py

[report]
precision = 2
show_missing = True
skip_covered = False
# The CI coverage gate (was --cov-fail-under=75 in the CI command line).
fail_under = 75

[html]
directory = htmlcov
